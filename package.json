{
  "name": "space",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, high-performance JavaScript/TypeScript toolkit for bringing space, astronomy, and real-time celestial data to the web.",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "typecheck": "turbo run typecheck",
    "clean": "pnpm -r exec rm -rf node_modules dist"
  },
  "keywords": [
    "space",
    "astronomy",
    "javascript",
    "typescript",
    "space-sdk",
    "space-data",
    "astronomy-library",
    "webgl",
    "webgpu",
    "3d"
  ],
  "license": "MIT",
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
